# ==============================================================================
# SafeVision AI - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# NOTE: Never commit '.env' containing real secrets to version control.
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Project Information
PROJECT_NAME="PPE Monitoring System"
PROJECT_DESCRIPTION="AI-Powered Real-Time PPE Detection and Industrial Safety Monitoring System"
VERSION="1.0.0"

# ==============================================================================
# Automatic Email Alert & Notification Configuration
# ==============================================================================
# Default violation notification recipient
EMAIL_RECIPIENT=safety_officer@example.com

# Enable/Disable email notification engine (True/False)
EMAIL_ENABLED=False

# SMTP Server Settings (Example shown for Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Sender & Authentication
SMTP_SENDER_EMAIL=alerts@example.com
SMTP_USERNAME=alerts@example.com

# SMTP Password
# IMPORTANT FOR GMAIL: If 2-Step Verification is active, generate and use an
# "App Password" (16 characters) from https://myaccount.google.com/apppasswords
# DO NOT use your standard personal Google account password!
SMTP_PASSWORD=your_16_char_app_password_here

# Ongoing Violation Reminder Frequency (Default: 5 minutes)
EMAIL_REMINDER_INTERVAL_MINUTES=5

